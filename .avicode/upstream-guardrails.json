{
  "version": 1,
  "upstream": {
    "repository": "pingdotgg/t3code",
    "branch": "main"
  },
  "releaseRepository": "TheDarkPhantom/avicode",
  "identity": {
    "productName": "AviCode",
    "appId": "com.advisoravi.avicode",
    "protocol": "avicode://",
    "dataHome": "~/.avicode",
    "executable": "AviCode.exe",
    "codexOriginator": "avicode_desktop"
  },
  "boundaries": [
    {
      "id": "upstream-sync",
      "owner": "AviCodeIdentity",
      "state": "active",
      "requiredFiles": [
        ".github/workflows/sync-upstream.yml",
        ".github/workflows/avicode-guardrails.yml",
        "scripts/avicode/check-upstream-guardrails.mjs",
        "docs/UPSTREAM_SYNC.md"
      ],
      "requiredText": [
        {
          "file": ".github/workflows/sync-upstream.yml",
          "values": [
            "0 1 * * 1",
            "pingdotgg/t3code",
            "git merge --no-ff",
            "gh pr create",
            "publish: never"
          ]
        }
      ]
    },
    {
      "id": "branding",
      "owner": "AviCodeBranding",
      "state": "active",
      "requiredFiles": ["assets/prod/logo.svg", "scripts/avicode/export-brand-assets.mjs"],
      "requiredText": [
        {
          "file": "assets/prod/logo.svg",
          "values": ["#0C0A0A", "#DE5257", "#C99A2E"]
        }
      ]
    },
    {
      "id": "identity",
      "owner": "AviCodeIdentity",
      "state": "active",
      "requiredFiles": [
        "packages/shared/src/avicodeIdentity.ts",
        "apps/desktop/src/app/LegacyT3Import.ts"
      ],
      "requiredText": [
        {
          "file": "packages/shared/src/avicodeIdentity.ts",
          "values": ["com.advisoravi.avicode", "avicode_desktop", "TheDarkPhantom", ".avicode"]
        }
      ]
    },
    {
      "id": "document-attachments",
      "owner": "DocumentAttachments",
      "state": "active",
      "requiredFiles": ["apps/web/src/lib/documentAttachments.ts", "docs/DOCUMENT_ATTACHMENTS.md"],
      "requiredText": [
        {
          "file": "packages/contracts/src/orchestration.ts",
          "values": ["ChatDocumentAttachment", "PROVIDER_SEND_TURN_MAX_DOCUMENT_CHARS"]
        }
      ]
    },
    {
      "id": "window-title-metadata",
      "owner": "WindowTitleMetadata",
      "state": "active",
      "requiredFiles": ["apps/web/src/lib/windowTitleMetadata.ts"],
      "requiredText": [
        {
          "file": "apps/web/src/lib/windowTitleMetadata.ts",
          "values": ["repository", "threadTitle", "AVICODE_IDENTITY.productName"]
        }
      ]
    },
    {
      "id": "alfred-compatibility",
      "owner": "ALFRED-CODE",
      "state": "active",
      "requiredFiles": ["docs/ALFRED_INTEGRATION.md"],
      "requiredText": [
        {
          "file": "docs/ALFRED_INTEGRATION.md",
          "values": ["avicode_desktop", "t3code_desktop", "ActivityWatch"]
        }
      ]
    }
  ]
}
