{
  "version": 2,
  "boundaries": [
    {
      "id": "identity",
      "why": "Avi Code 2 installs next to T3 Code and the old Avi Code, and releases only from this fork.",
      "requiredFiles": [
        "packages/shared/src/avicodeIdentity.ts",
        "apps/desktop/package.json",
        "scripts/build-desktop-artifact.ts"
      ],
      "requiredText": [
        {
          "file": "packages/shared/src/avicodeIdentity.ts",
          "values": [
            "productName: \"Avi Code 2\"",
            "appId: \"com.advisoravi.avicode2\"",
            "homeDirectoryName: \".avicode2\"",
            "sessionOriginator: \"avicode_desktop\"",
            "releaseOwner: \"TheDarkPhantom\"",
            "releaseSlug: \"TheDarkPhantom/avicode\""
          ]
        },
        {
          "file": "apps/desktop/package.json",
          "values": ["\"productName\": \"Avi Code 2\""]
        },
        {
          "file": "scripts/build-desktop-artifact.ts",
          "values": [
            "const DESKTOP_APP_ID = AVICODE_IDENTITY.appId;",
            "AVICODE_IDENTITY.releaseSlug.toLowerCase()",
            "executableName: AVICODE_IDENTITY.executableName"
          ]
        }
      ]
    },
    {
      "id": "branding",
      "why": "Upstream ships T3 Code's logo and name in the renderer.",
      "requiredFiles": [
        "assets/prod/logo.svg",
        "apps/web/index.html",
        "apps/web/public/manifest.webmanifest"
      ],
      "requiredText": [
        {
          "file": "assets/prod/logo.svg",
          "values": ["#0C0A0A", "#DE5257", "#C99A2E", "#EDE7E3", "#4F9D69"]
        },
        {
          "file": "apps/web/index.html",
          "values": ["<title>Avi Code 2</title>"]
        },
        {
          "file": "apps/web/public/manifest.webmanifest",
          "values": ["\"name\": \"Avi Code 2\"", "\"short_name\": \"Avi Code 2\""]
        }
      ]
    },
    {
      "id": "release",
      "why": "Releases are built by hand, never marked Latest, and carry no update feed.",
      "requiredFiles": [".github/workflows/avicode-release.yml"],
      "manualOnlyWorkflows": [".github/workflows/avicode-release.yml"],
      "requiredText": [
        {
          "file": ".github/workflows/avicode-release.yml",
          "values": [
            "github.repository == 'TheDarkPhantom/avicode'",
            "--latest=false",
            "T3CODE_DESKTOP_UPDATE_REPOSITORY: none/none"
          ]
        }
      ]
    },
    {
      "id": "upstream-sync",
      "why": "Upstream syncs arrive as reviewed PRs and never merge or release on their own.",
      "requiredFiles": [
        ".github/workflows/sync-upstream.yml",
        ".github/workflows/avicode-guardrails.yml",
        "scripts/avicode/check-upstream-guardrails.mjs",
        "docs/UPSTREAM_SYNC.md"
      ],
      "requiredText": [
        {
          "file": ".github/workflows/sync-upstream.yml",
          "values": ["pingdotgg/t3code", "git fetch --no-tags upstream", "git merge --no-ff"],
          "forbiddenValues": ["gh pr merge", "--auto", "workflow_run:", "create-release"]
        }
      ]
    },
    {
      "id": "changelog",
      "why": "The in-app changelog page reads the fork's CHANGELOG.md.",
      "requiredFiles": [
        "CHANGELOG.md",
        "apps/web/src/changelog/parseChangelog.ts",
        "apps/web/src/routes/_chat.changelog.tsx"
      ]
    },
    {
      "id": "privacy",
      "why": "Analytics stay off by default and the app does not promote T3 services.",
      "requiredFiles": [
        "apps/server/src/telemetry/AnalyticsService.ts",
        "apps/web/src/routes/__root.tsx"
      ],
      "requiredText": [
        {
          "file": "apps/server/src/telemetry/AnalyticsService.ts",
          "values": [
            "Avi Code addition: analytics stay off unless T3CODE_TELEMETRY_ENABLED opts in.",
            "const enabledByDefault = false;"
          ]
        },
        {
          "file": "packages/shared/src/avicodeIdentity.ts",
          "values": ["showsUpstreamPromotions: false"]
        },
        {
          "file": "apps/web/src/routes/__root.tsx",
          "values": [
            "AVICODE_IDENTITY.showsUpstreamPromotions ? <ConnectOnboardingDialog /> : null"
          ]
        }
      ]
    },
    {
      "id": "avicode-settings",
      "why": "Fork settings join upstream at single sites a sync could drop. Time trackers rely on the window title toggle, and new chats read the plan mode setting.",
      "requiredFiles": [
        "packages/contracts/src/avicodeSettings.ts",
        "apps/web/src/avicode/windowTitleNames.ts",
        "apps/web/src/avicode/newThreadInteractionMode.ts",
        "apps/web/src/components/settings/AviCodeSettingsPanel.tsx",
        "apps/web/src/routes/_chat.settings.avicode.tsx"
      ],
      "requiredText": [
        {
          "file": "packages/contracts/src/settings.ts",
          "values": [
            "...AVICODE_CLIENT_SETTINGS_FIELDS,",
            "...AVICODE_CLIENT_SETTINGS_PATCH_FIELDS,"
          ]
        },
        {
          "file": "apps/web/src/appInit.tsx",
          "values": ["...avicodeWindowTitleNames("]
        },
        {
          "file": "apps/web/src/components/settings/settingsSearch.ts",
          "values": ["\"/settings/avicode\",", "...AVICODE_SETTINGS_SEARCH_ITEMS,"]
        },
        {
          "file": "apps/web/src/composerDraftStore.ts",
          "values": ["existingThread?.interactionMode ??", "resolveInitialInteractionMode(),"]
        },
        {
          "file": "apps/web/src/hooks/useHandleNewThread.ts",
          "values": ["const carryInteractionMode = resolveNewThreadInteractionMode("]
        },
        {
          "file": "apps/web/src/hooks/useSettings.ts",
          "values": [
            "registerStartInPlanModeReader(() => clientSettingsSnapshot.aviCodeNewThreadsStartInPlanMode);"
          ]
        }
      ]
    },
    {
      "id": "quick-send-chips",
      "why": "Quick-send chips join the composer at one site a sync could drop.",
      "requiredFiles": [
        "apps/web/src/avicode/composerChips.ts",
        "apps/web/src/avicode/ComposerChipRow.tsx",
        "apps/web/src/avicode/QuickSendChipsSettings.tsx"
      ],
      "requiredText": [
        {
          "file": "apps/web/src/components/chat/ChatComposer.tsx",
          "values": [
            "import { ComposerChipRow } from \"~/avicode/ComposerChipRow\";",
            "const pickComposerChip = useStableCallback((text: string) => {",
            "onPick={pickComposerChip}"
          ]
        },
        {
          "file": "packages/contracts/src/settings.ts",
          "values": ["export * from \"./avicodeSettings.ts\";"]
        }
      ]
    },
    {
      "id": "sidebar-project-menu",
      "why": "The sidebar project menu opens the folder in the OS file manager, added at one upstream site.",
      "requiredText": [
        {
          "file": "apps/web/src/components/Sidebar.tsx",
          "values": ["id: \"open-file-manager\",", "case \"open-file-manager\":"]
        }
      ]
    },
    {
      "id": "notification-sounds",
      "why": "The picked notification sounds replace upstream's bundled ones at one site a sync could drop.",
      "requiredFiles": ["apps/web/src/avicode/notificationSounds.ts"],
      "requiredText": [
        {
          "file": "apps/web/src/threadNotifications.ts",
          "values": [
            "const aviCodeSound = avicodeNotificationSoundFor(kind, getClientSettings());",
            "return playAviCodeNotificationSound(context, kind, aviCodeSound, shouldPlay);"
          ]
        }
      ]
    },
    {
      "id": "preview-bookmarks",
      "why": "The bookmarks bar joins the preview's new-tab page at one site a sync could drop.",
      "requiredFiles": [
        "apps/web/src/avicode/browserBookmarksStore.ts",
        "apps/web/src/avicode/PreviewBookmarksBar.tsx"
      ],
      "requiredText": [
        {
          "file": "apps/web/src/components/preview/PreviewEmptyState.tsx",
          "values": [
            "import { PreviewBookmarksBar } from \"~/avicode/PreviewBookmarksBar\";",
            "<PreviewBookmarksBar threadRef={props.threadRef} onOpenUrl={props.onOpenUrl} />",
            "<PreviewEmptyStateContent {...props} />"
          ]
        }
      ]
    },
    {
      "id": "color-themes",
      "why": "The first Avi Code's colour themes join upstream's built-in themes at three upstream sites.",
      "requiredFiles": ["packages/shared/src/avicodeThemes.ts"],
      "requiredText": [
        {
          "file": "packages/shared/src/themePalettes.ts",
          "values": ["...AVICODE_THEME_IDS,", "...AVICODE_THEMES,"]
        },
        {
          "file": "apps/web/src/components/settings/ThemeSettings.tsx",
          "values": ["...AVICODE_THEMES,"]
        },
        {
          "file": "apps/web/index.html",
          "values": ["\"avicode-oxblood\": {", "\"avicode-graphite\": {"]
        }
      ]
    },
    {
      "id": "thread-close-reopen-keys",
      "why": "Ctrl+W archives and Ctrl+Shift+T reopens archived threads through upstream keybinding sites.",
      "requiredFiles": [
        "apps/web/src/avicode/threadCloseReopen.ts",
        "apps/web/src/avicode/useThreadArchiveShortcuts.ts",
        "apps/web/src/avicode/useReopenLastArchivedThreadShortcut.ts"
      ],
      "requiredText": [
        {
          "file": "packages/contracts/src/keybindings.ts",
          "values": ["\"thread.archive\",", "\"thread.reopenLastArchived\","]
        },
        {
          "file": "packages/shared/src/keybindings.ts",
          "values": [
            "{ key: \"mod+w\", command: \"thread.archive\", when: \"!terminalFocus && !rightPanelOpen\" },"
          ]
        },
        {
          "file": "apps/web/src/components/ChatView.tsx",
          "values": [
            "const threadArchiveShortcuts = useThreadArchiveShortcuts({",
            "...threadArchiveShortcuts,"
          ]
        },
        {
          "file": "apps/web/src/components/ReopenClosedViewShortcut.tsx",
          "values": [
            "useReopenLastArchivedThreadShortcut({ keybindings, terminalOpen, previewOpen });",
            "withoutCommand(keybindings, \"thread.reopenLastArchived\"),"
          ]
        },
        {
          "file": "apps/web/src/components/pullRequest/PullRequestsPage.tsx",
          "values": ["withoutCommand(keybindings, \"thread.archive\")"]
        },
        {
          "file": "apps/web/src/components/issue/IssuesPage.tsx",
          "values": ["withoutCommand(keybindings, \"thread.archive\")"]
        },
        {
          "file": "apps/web/src/components/settings/KeybindingsSettings.logic.ts",
          "values": ["\"thread.archive\": msg(\"Thread: Archive\"),"]
        },
        {
          "file": "apps/web/src/components/CommandPaletteThreadActions.tsx",
          "values": ["archive: \"thread.archive\","]
        }
      ]
    }
  ],
  "brandBan": {
    "text": "T3 Code",
    "why": "TRADEMARK.md requires our own branding in fork-owned files. Allow only factual attribution.",
    "paths": [
      "scripts/avicode",
      "packages/shared/src/avicodeIdentity.ts",
      "apps/web/src/changelog",
      "apps/web/src/components/changelog",
      "apps/web/src/avicode",
      "apps/web/src/components/settings/AviCodeSettingsPanel.tsx",
      "apps/web/src/components/settings/avicodeSettingsSearch.ts",
      "packages/contracts/src/avicodeSettings.ts"
    ],
    "allowedLines": {
      "packages/shared/src/avicodeIdentity.ts": [
        "/** T3 Connect onboarding, the mobile app row and the GitHub star prompt promote T3 Code. */"
      ],
      "apps/web/src/components/changelog/ChangelogPage.tsx": ["const UPSTREAM_NAME = \"T3 Code\";"]
    }
  }
}
